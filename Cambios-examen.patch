+# Matthew Juarez | 0901-23-4250 | 24/11/2026 | Compila el ejecutable del examen.
+param([ValidateSet('Debug', 'Release')][string]$Configuracion = 'Debug')
+$ErrorActionPreference = 'Stop'
+$vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio/Installer/vswhere.exe'
+$msbuild = & $vswhere -latest -products '*' -requires Microsoft.Component.MSBuild -find 'MSBuild/Current/Bin/MSBuild.exe' | Select-Object -First 1
+if (!$msbuild) { throw 'Se requiere MSBuild de Visual Studio con Desarrollo de escritorio de .NET.' }
+
+$solucion = Join-Path $PSScriptRoot '../codigo/modulos/ventas/Ejecutable_Ventas/Ejecucion_Ventas.sln'
+& $msbuild $solucion -restore -m -p:RestorePackagesConfig=true "-p:Configuration=$Configuracion" -verbosity:minimal
+if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
